{
  "watch": ["./app/layout.js", "./app/clinic-detail.css"],
  "pages": [
    {
      "id": "new-service",
      "path": "/services/example",
      "goal": "처음 방문할 환자가 검사 순서와 준비 내용을 이해할 수 있게 한다.",
      "hero": "#service-hero",
      "sections": [
        {
          "id": "hero",
          "selector": "#service-hero",
          "reference": "injection/hero",
          "implementation": "./app/services/example/page.js",
          "purpose": "어떤 진료를 안내하는 페이지인가?",
          "keep": ["전면 배경과 제목·본문의 정보 위계", "히어로 높이와 제목 규격"],
          "lockHeight": true,
          "lockTypography": true
        },
        {
          "id": "assessment",
          "selector": "#assessment",
          "reference": "prp-prf/photo-split",
          "implementation": "./app/services/example/page.js",
          "purpose": "첫 방문에서 어떤 검사가 이루어지는가?",
          "keep": ["사진과 설명의 위아래 정렬", "모바일에서는 자연스러운 읽기 순서"],
          "minimum": {"img": 1}
        },
        {
          "id": "story",
          "selector": "#story",
          "reference": "sports/parallax",
          "implementation": "./app/services/example/page.js",
          "purpose": "검사 후에는 어떤 이야기를 나누는가?",
          "keep": ["배경 이미지와 어두운 오버레이", "앞 뒤 밝은 구간과 대비"],
          "minimum": {".journey-backdrop": 1}
        },
        {
          "id": "questions",
          "selector": "#questions",
          "reference": "regen/faq",
          "implementation": "./app/services/example/page.js",
          "purpose": "진료 전에 가장 많이 묻는 질문은 무엇인가?",
          "keep": ["펼쳐진 답변", "모바일에서 읽기 쉬운 줄 길이"],
          "minimum": {".ro-faq-answer": 3}
        }
      ],
      "interactions": [
        {"click": "#service-hero a[href='#assessment']", "url": "/services/example#assessment"}
      ]
    }
  ]
}
